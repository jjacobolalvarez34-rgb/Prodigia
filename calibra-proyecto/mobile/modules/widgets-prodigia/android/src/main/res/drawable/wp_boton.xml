<?xml version="1.0" encoding="utf-8"?>
<!-- Botón dorado con sombra dura (como Boton3D de la app). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:top="3dp">
    <shape android:shape="rectangle">
      <solid android:color="#FF05060F" />
      <corners android:radius="13dp" />
    </shape>
  </item>
  <item android:bottom="3dp">
    <shape android:shape="rectangle">
      <gradient android:angle="270" android:startColor="#FFFFD36B" android:endColor="#FFFFB627" />
      <corners android:radius="13dp" />
      <stroke android:width="1.5dp" android:color="#FF05060F" />
    </shape>
  </item>
  <item android:bottom="3dp" android:left="12dp" android:right="12dp" android:top="2dp" android:gravity="top" android:height="1.5dp">
    <shape android:shape="rectangle">
      <solid android:color="#80FFF6D6" />
      <corners android:radius="1dp" />
    </shape>
  </item>
</layer-list>
