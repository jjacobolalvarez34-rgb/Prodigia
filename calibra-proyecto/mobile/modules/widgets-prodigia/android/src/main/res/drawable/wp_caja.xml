<?xml version="1.0" encoding="utf-8"?>
<!-- Caja de vidrio: degradé claro arriba, borde fino y un brillo en el canto superior. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#0DFFFFFF" />
      <corners android:radius="14dp" />
      <stroke android:width="1dp" android:color="#26FFFFFF" />
    </shape>
  </item>
  <item android:left="10dp" android:right="10dp" android:top="1dp" android:gravity="top" android:height="1dp">
    <shape android:shape="rectangle">
      <solid android:color="#40FFFFFF" />
    </shape>
  </item>
</layer-list>
