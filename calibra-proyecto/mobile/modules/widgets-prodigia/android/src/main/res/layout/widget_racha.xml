<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/wp_raiz"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/wp_fondo"
  android:orientation="vertical"
  android:gravity="center_vertical"
  android:padding="14dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="✦ PRODIGIA"
    android:textColor="@color/wp_neon"
    android:textSize="11sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/wp_racha"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="🔥 0"
    android:textColor="@color/wp_racha"
    android:textSize="34sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/wp_racha_texto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="días de racha"
    android:textColor="@color/wp_texto2"
    android:textSize="12sp" />

  <TextView
    android:id="@+id/wp_chispas"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/wp_pildora"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp"
    android:text="⚡ 0"
    android:textColor="@color/wp_logro"
    android:textSize="13sp"
    android:textStyle="bold" />
</LinearLayout>
