{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "fal-ai": {
      "type": "remote",
      "url": "https://mcp.fal.ai/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:FAL_KEY}"
      },
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    }
  }
}